# Keep deterministic for offline tests. Set gemini only when live provider is intended.
REPORT_QA_AI_MODE=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
REPORT_QA_AI_TIMEOUT_SECONDS=30
REPORT_QA_AI_RETRIES=1
# Persistence backend. Keep json for the offline demo; switch to postgres only
# after running infra/compose/dev.yml and the migration/connection checks.
PERSISTENCE_BACKEND=json
DATABASE_URL=postgresql+psycopg://sourcelens:sourcelens-dev-only@127.0.0.1:5432/sourcelens
POSTGRES_DB=sourcelens
POSTGRES_USER=sourcelens
POSTGRES_PASSWORD=sourcelens-dev-only
POSTGRES_PORT=5432
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=sourcelens
MINIO_ROOT_USER=sourcelens
MINIO_ROOT_PASSWORD=sourcelens-dev-only
# Alternative live adapter:
# REPORT_QA_AI_MODE=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-6-luna
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
