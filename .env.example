# Keep deterministic for offline tests. Set gemini only when live provider is intended.
REPORT_QA_AI_MODE=deterministic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
REPORT_QA_AI_TIMEOUT_SECONDS=30
# Gemini thinking level for the planner/assistant. Gemini 3.x rejects
# "minimal"; empty omits the field.
REPORT_QA_REASONING_EFFORT=low
REPORT_QA_AI_RETRIES=1
# Document assistant. "tools" lets the AI read full PDF text, the Data table and
# charts on demand (needs REPORT_QA_PLANNER_MODE=gemini|openrouter|sambanova and
# its key). "legacy" keeps the rule/planner flow.
REPORT_QA_ASSISTANT_MODE=legacy
# PDF extraction. "docling" (default) needs `pip install -e ".[docling-deplot]"`
# (torch + models); without it every upload fails with
# extraction_error=MISSING_DEPENDENCY:docling. "legacy" needs only
# `pip install -e ".[pdf-extraction]"`.
PDF_EXTRACTION_BACKEND=docling
# vi = "1.234,5", en = "1,234.5"; empty marks "1.234"-style numbers ambiguous.
PDF_NUMBER_LOCALE=
# Chart reader for questions that need chart values: deplot | vector.
CHART_READER_BACKEND=deplot
# Persistence backend. Keep json for the offline demo; switch to postgres only
# after running infra/compose/dev.yml and the migration/connection checks.
PERSISTENCE_BACKEND=json
DATABASE_URL=postgresql+psycopg://sourcelens:sourcelens-dev-only@127.0.0.1:5432/sourcelens
POSTGRES_DB=sourcelens
POSTGRES_USER=sourcelens
POSTGRES_PASSWORD=sourcelens-dev-only
POSTGRES_PORT=5432
# Object storage. Use local only for offline tests; R2 is the durable runtime.
STORAGE_BACKEND=r2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=sourcelens-documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Alternative live adapter:
# REPORT_QA_AI_MODE=openrouter
# Authentication is available only with PostgreSQL. Keep false for the local
# compatibility demo until every business route is owner-scoped.
AUTH_REQUIRED=false
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=30
AUTH_EXPOSE_RESET_TOKEN=false
# Set true only after the PostgreSQL worker is running. This changes chat
# responses to 202 + assistant placeholder and lets the worker finish AI.
ASYNC_ANSWER_JOBS=false
SOURCELENS_WORKER_ID=worker-local
# Handout production path: Docling extracts positioned text/tables at upload.
# Set legacy only for a deliberate compatibility fallback.
PDF_EXTRACTION_BACKEND=docling
# Chart reading is question-scoped; the optional DePlot model is loaded only
# when a question explicitly requires a chart.
CHART_READER_BACKEND=deplot
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-6-luna
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
