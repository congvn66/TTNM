{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/contracts/semantic-v1.schema.json",
  "title": "Evidence semantic v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "measure", "subject", "unit", "period", "dimensions", "value_operator"],
  "properties": {
    "schema_version": {"const": 1},
    "measure": {"$ref": "#/$defs/entity"},
    "subject": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/entity"}]},
    "unit": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "label", "multiplier"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "label": {"type": "string", "minLength": 1},
            "multiplier": {"$ref": "#/$defs/decimal"}
          }
        }
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "label", "start", "end", "basis", "source_region_ids"],
      "properties": {
        "status": {"enum": ["known", "partial", "unspecified", "not_applicable"]},
        "label": {"type": ["string", "null"]},
        "start": {"type": ["string", "null"], "format": "date"},
        "end": {"type": ["string", "null"], "format": "date"},
        "basis": {"enum": ["explicit", "context", "user", null]},
        "source_region_ids": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "known"}}},
          "then": {"properties": {"start": {"type": "string"}, "end": {"type": "string"}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["unspecified", "not_applicable"]}}},
          "then": {"properties": {"start": {"type": "null"}, "end": {"type": "null"}}}
        }
      ]
    },
    "dimensions": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "value_operator": {"enum": ["eq", "gt", "gte", "lt", "lte", "approx"]}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label"],
      "properties": {
        "code": {"type": ["string", "null"]},
        "label": {"type": "string", "minLength": 1}
      }
    }
  }
}
