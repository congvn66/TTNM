{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcelens.local/contracts/tool-invocation-v1.schema.json",
  "title": "SourceLens tool invocation envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "invocation_id", "trace_id", "tool", "operation", "status", "attempt", "input", "output", "error", "timing", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "provider", "model"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]}
      }
    },
    "operation": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "succeeded", "partial", "failed", "rejected", "cancelled"]},
    "attempt": {"type": "integer", "minimum": 1},
    "input": {"$ref": "#/$defs/artifact"},
    "output": {"$ref": "#/$defs/artifact"},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["code", "category", "retryable", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "category": {"enum": ["validation", "unsupported_input", "timeout", "rate_limit", "provider", "storage", "internal", "cancelled", "stale_input"]},
            "retryable": {"type": "boolean"},
            "message": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "timing": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at", "finished_at", "latency_ms"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "latency_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "version", "payload_sha256", "artifact_refs"],
      "properties": {
        "contract": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["succeeded", "partial"]}}}, "then": {"properties": {"output": {"type": "object"}}}},
    {"if": {"properties": {"status": {"enum": ["failed", "rejected", "cancelled"]}}}, "then": {"required": ["error"]}}
  ]
}
