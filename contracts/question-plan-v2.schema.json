{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcelens.local/contracts/question-plan-v2.schema.json",
  "title": "Question execution plan v2",
  "description": "Machine-readable interpretation of a question before retrieval or calculation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "question_plan_id", "document_version_id", "original_question", "language", "status", "facts", "operation", "source_strategy", "clarification"],
  "properties": {
    "schema_version": {"const": 2},
    "question_plan_id": {"type": "string", "minLength": 1},
    "document_version_id": {"type": "string", "minLength": 1},
    "original_question": {"type": "string", "minLength": 1},
    "language": {"enum": ["vi", "en", "other"]},
    "status": {"enum": ["ready", "needs_clarification", "unsupported"]},
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_key", "measure", "subject", "period", "unit", "dimensions", "required", "allowed_sources"],
        "properties": {
          "fact_key": {"type": "string", "minLength": 1},
          "measure": {"type": "string", "minLength": 1},
          "subject": {"type": ["string", "null"]},
          "period": {"type": ["string", "null"]},
          "unit": {"type": ["string", "null"]},
          "dimensions": {"type": "object", "additionalProperties": {"type": "string"}},
          "required": {"type": "boolean"},
          "allowed_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text", "table", "chart"]}}
        }
      }
    },
    "operation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "formula_id", "operand_fact_keys", "result_unit"],
          "properties": {
            "type": {"enum": ["lookup", "sum", "difference", "absolute_change", "growth_rate", "percentage_point_change", "compare", "ranking"]},
            "formula_id": {"enum": ["identity_v1", "sum_v1", "subtract_v1", "absolute_change_v1", "growth_rate_v1", "percentage_point_change_v1", "compare_v1", "ranking_v1"]},
            "operand_fact_keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "result_unit": {"type": ["string", "null"]}
          },
          "allOf": [
            {"if": {"properties": {"type": {"const": "lookup"}}}, "then": {"properties": {"formula_id": {"const": "identity_v1"}, "operand_fact_keys": {"minItems": 1, "maxItems": 1}}}},
            {"if": {"properties": {"type": {"const": "sum"}}}, "then": {"properties": {"formula_id": {"const": "sum_v1"}}}},
            {"if": {"properties": {"type": {"const": "difference"}}}, "then": {"properties": {"formula_id": {"const": "subtract_v1"}, "operand_fact_keys": {"minItems": 2, "maxItems": 2}}}},
            {"if": {"properties": {"type": {"const": "absolute_change"}}}, "then": {"properties": {"formula_id": {"const": "absolute_change_v1"}, "operand_fact_keys": {"minItems": 2, "maxItems": 2}}}},
            {"if": {"properties": {"type": {"const": "growth_rate"}}}, "then": {"properties": {"formula_id": {"const": "growth_rate_v1"}, "operand_fact_keys": {"minItems": 2, "maxItems": 2}}}},
            {"if": {"properties": {"type": {"const": "percentage_point_change"}}}, "then": {"properties": {"formula_id": {"const": "percentage_point_change_v1"}, "operand_fact_keys": {"minItems": 2, "maxItems": 2}}}},
            {"if": {"properties": {"type": {"const": "compare"}}}, "then": {"properties": {"formula_id": {"const": "compare_v1"}, "operand_fact_keys": {"minItems": 2}}}},
            {"if": {"properties": {"type": {"const": "ranking"}}}, "then": {"properties": {"formula_id": {"const": "ranking_v1"}, "operand_fact_keys": {"minItems": 2}}}}
          ]
        }
      ]
    },
    "source_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priority", "chart_policy", "chart_fact_keys"],
      "properties": {
        "priority": {"const": ["table", "text", "chart"]},
        "chart_policy": {"const": "only_if_required_fact_unresolved"},
        "chart_fact_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "clarification": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_code", "question_to_user", "options"],
          "properties": {
            "reason_code": {"enum": ["AMBIGUOUS_MEASURE", "AMBIGUOUS_PERIOD", "AMBIGUOUS_OPERATION", "AMBIGUOUS_SUBJECT", "MISSING_CONTEXT"]},
            "question_to_user": {"type": "string", "minLength": 1},
            "options": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {"properties": {"facts": {"minItems": 1}, "operation": {"type": "object"}, "clarification": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "needs_clarification"}}},
      "then": {"properties": {"clarification": {"type": "object"}}}
    }
  ]
}
